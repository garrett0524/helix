# Server
PORT=3001
NODE_ENV=production
JWT_SECRET=<generate-a-random-64-char-string>

# Database
DATABASE_URL=postgresql://helix:password@localhost:5432/helix

# Optional: Override individual PG vars
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=helix
# PGUSER=helix
# PGPASSWORD=password

# Optional: App URL for Google Calendar OAuth redirect
# APP_URL=https://your-domain.com

# Apollo.io API key (lead enrichment + sequences)
APOLLO_API_KEY=

# Anthropic API key (Claude meeting analysis)
ANTHROPIC_API_KEY=

# Google OAuth (calendar sync, optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Whisper model size for transcription (tiny | base | small | medium | large)
WHISPER_MODEL_SIZE=base
